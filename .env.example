# AgentGate Environment Variables Template
# Copy to .env for local runtime execution. NEVER commit sensitive production values.

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/agentgate
SPRING_DATASOURCE_USERNAME=agentgate_user
SPRING_DATASOURCE_PASSWORD=agentgate_secure_password_placeholder

# Redis Configuration
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Server Port
PORT=8080

# Security & JWT Token Verification
AGENTGATE_JWT_ISSUER=https://auth.agentgate.local
AGENTGATE_JWT_AUDIENCE=agentgate-core
AGENTGATE_JWT_SECRET=replace_with_at_least_256_bit_random_hex_secret_in_production

# Admin Credentials for Web UI & Administrative APIs
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password
